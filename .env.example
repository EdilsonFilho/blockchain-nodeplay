# NodePlay configuration — copy to .env and adjust:  cp .env.example .env
# Variables already set in the shell take precedence over this file.

# ---------------------------------------------------------------- network
# Wi-Fi every participant must join. Shown on the dashboard (name, password
# and a "join Wi-Fi" QR code). Leave WIFI_SSID empty to hide this step.
WIFI_SSID=NodePlay-Lab
WIFI_PASSWORD=change-me
# WPA (WPA/WPA2/WPA3), WEP or nopass. Optional: inferred from the password.
WIFI_SECURITY=WPA

# Server IP phones connect to. Leave empty to auto-detect it at startup.
# Set it only if the wrong interface is picked (VPN, Docker, several NICs).
HOST_IP=
# Full public URL; overrides HOST_IP and auto-detection (e.g. http://192.168.0.10:8000).
PUBLIC_URL=
# Port used by `python main.py` (with uvicorn use --port).
PORT=8000

# ---------------------------------------------------------------- roles
# No limit on participants: each newcomer gets a random role among those with
# a free seat. The first participant is always a WRITER.
# Total validators, bot validators included.
MAX_VALIDATORS=7
# Writer seats (0 = unlimited).
MAX_WRITERS=0

# Built-in bot validators that ALWAYS approve. They take validator seats
# (4 of 7 = majority), so a single writer is enough to create blocks.
# false = blocks need a simple majority of the human validators.
BOT_VALIDATORS_ENABLED=true
BOT_VALIDATORS_COUNT=4

# ---------------------------------------------------------------- activity
GAME_DURATION=300
VOTE_TIMEOUT=10
RESULT_PAUSE=2
MAX_MISSED_VOTES=2
MAX_TX_LENGTH=48

# Protects START/STOP/RESET: open the dashboard as /dashboard?token=<value>.
ADMIN_TOKEN=
